<!-- 插件配置文件。https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- 插件ID。必须是一个 FQN 且不可变更 -->
    <id>net.navifox.plugins.multi-root-workspace-view</id>

    <!-- 插件名称。https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Multi-Root Workspace View</name>

    <!-- 插件作者。在插件页会显示的供应商名称或组织ID -->
    <vendor url="https://www.navifox.net">Navifox</vendor>

    <!-- 插件描述。https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <!-- <description></description> -->

    <!-- 插件依赖。https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.NavifoxMessageBundle</resource-bundle>

    <!-- 扩展点位。https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <projectViewPane implementation="net.navifox.plugins.workspace.MrWorkspaceViewPane" />
        <selectInTarget implementation="net.navifox.plugins.workspace.MrWorkspaceSelectInTarget" />
        <projectConfigurable groupId="tools"
                             instance="net.navifox.plugins.workspace.MrWorkspaceSettingsConfigurable"
                             id="net.navifox.plugins.workspace.settings"
                             key="settings.tools.MrWorkspaceView.title" />
        <notificationGroup id="MultiRootWorkspaceView"
                           displayType="BALLOON"
                           bundle="messages.NavifoxMessageBundle"
                           key="notification.group.multirootWorkspaceView" />
    </extensions>

</idea-plugin>
