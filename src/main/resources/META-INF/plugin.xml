<!-- 插件配置文件。https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- 插件ID。必须是一个 FQN 且不可变更 -->
    <id>net.navifox.plugins.mr-workspace</id>

    <!-- 插件名称。https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Multi-Root Workspace</name>

    <!-- 插件作者。在插件页会显示的供应商名称或组织ID -->
    <vendor url="https://www.navifox.net">Navifox</vendor>

    <!-- 插件描述。https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <!-- <description></description> -->

    <!-- 插件依赖。https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.NavifoxMessageBundle</resource-bundle>

    <!-- 扩展点位。https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <projectViewPane implementation="net.navifox.plugins.workspace.MrWorkspacePane" />
        <selectInTarget implementation="net.navifox.plugins.workspace.MrWorkspaceSelectInTarget" />
        <projectConfigurable groupId="tools"
                             instance="net.navifox.plugins.workspace.MrWorkspaceSettingsConfigurable"
                             id="net.navifox.plugins.workspace.settings"
                             key="settings.tools.MrWorkspace.title" />
        <notificationGroup id="MrWorkspace"
                           displayType="BALLOON"
                           bundle="messages.NavifoxMessageBundle"
                           key="notification.group.mrWorkspace" />
    </extensions>

    <!-- “文件夹”菜单：工具窗口头部里是动作组（子菜单）；快捷键 Alt＋F2 由具名动作弹出同一份列表。 -->
    <actions>
        <action id="MrWorkspace.ShowFoldersMenu"
                class="net.navifox.plugins.workspace.MrFoldersMenuAction"
                icon="AllIcons.Nodes.Workspace">
            <keyboard-shortcut keymap="$default" first-keystroke="alt F2" />
        </action>

        <!--
            主工具栏（New UI）左侧的小组件：紧跟在 Project Widget 之后，点开是与工具窗口头部一致的
            “文件夹”列表，选中后激活工具窗口并过滤到该文件夹（New UI 的工具栏分组是 MainToolbarLeft）。
        -->
        <action id="MrWorkspace.FoldersWidget"
                class="net.navifox.plugins.workspace.MrWorkspaceFoldersWidgetAction"
                icon="AllIcons.Nodes.Workspace">
            <add-to-group group-id="MainToolbarLeft" anchor="after" relative-to-action="main.toolbar.Project" />
        </action>
    </actions>

</idea-plugin>
